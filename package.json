{
  "name": "m-js",
  "version": "3.0.0",
  "description": "A minimalist UI component framework for the web — Alpine-inspired templates, Zustand-like store, built-in Router & HMR.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./m": "./src/m.js",
