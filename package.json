{
  "name": "m-js",
  "version": "3.1.1",
  "description": "A minimalist UI component framework for the web \u2014 Alpine-inspired templates, Zustand-like store, built-in Router & HMR.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "browser": "dist/m.min.js",
  "unpkg": "dist/m.min.js",
  "jsdelivr": "dist/m.min.js",
  "exports": {
    ".": "./src/index.js",
    "./m": "./src/m.js",
    "./router": "./src/router.js",
    "./store": "./src/store.js",
    "./hot-client": "./src/hot-client.js",
    "./browser": "./src/browser.js",
    "./dist/m.js": "./dist/m.js",
    "./dist/m.min.js": "./dist/m.min.js"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "bun run src/server.js",
    "start": "bun run src/server.js",
    "build": "bun build.mjs package",
    "package": "bun build.mjs package",
    "release": "bun build.mjs release",
    "test": "bun test tests/",
    "test:watch": "bun test --watch tests/"
  },
  "keywords": [
    "ui",
    "component",
    "framework",
    "hmr",
    "router",
    "store"
  ],
  "author": "Mike Smullin",
  "license": "MIT",
  "dependencies": {
    "chokidar": "^4.0.3"
  },
  "devDependencies": {
    "happy-dom": "^20.11.1"
  }
}
