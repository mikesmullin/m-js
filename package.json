    "./store": "./src/store.js",
    "./hot-client": "./src/hot-client.js"
  },
  "scripts": {
    "dev": "bun run src/server.js",
    "start": "bun run src/server.js"
  },
  "keywords": [
    "ui",
    "component",
    "framework",
    "hmr",
    "router",
    "store"
  ],
